# Discord 봇 토큰
DISCORD_BOT_TOKEN=

# 봇에게 명령할 수 있는 사용자 ID (쉼표로 여러 개)
OWNER_IDS=

# 봇이 반응할 채널 ID (쉼표로 여러 개). 이 채널 안의 스레드도 포함
CHANNEL_IDS=

# 작업 공간 루트 (jobs/, worktrees/, sessions.json)
AGENT_ROOT=~/.agent

# 동시 실행 작업 수, 작업 하나의 최대 시간(초)
MAX_CONCURRENT=2
JOB_TIMEOUT_SEC=900

# 모델 (비우면 Claude Code 기본값)
CLAUDE_MODEL=
