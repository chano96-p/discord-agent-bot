<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent-bot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>__PNPM__</string>
    <string>start</string>
  </array>

  <!-- dotenv와 projects.json을 현재 디렉터리 기준으로 읽으므로 반드시 프로젝트 루트 -->
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <!-- launchd는 셸 프로필을 읽지 않아 node, pnpm, claude, git 경로를 직접 지정 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODE_BIN_DIR__:__PNPM_BIN_DIR__:__CLAUDE_BIN_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/agent-bot.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/agent-bot.log</string>
</dict>
</plist>
